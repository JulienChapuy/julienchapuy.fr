---
interface Props {
  title: string;
  description?: string;
  lang?: 'fr' | 'en';
}

const {
  title,
  description = 'AI Engineer spécialisé en LLM, architectures RAG et systèmes backend scalables.',
  lang = 'fr',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const frPath = path.startsWith('/en') ? path.slice(3) || '/' : path;
const enPath = `/en${frPath === '/' ? '' : frPath}`;
const site = Astro.site ?? Astro.url;
const canonical = new URL(path === '/' ? '/' : `${path}/`, site);
import 'devicon/devicon.min.css';
import Navbar from '../components/Navbar.astro';
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/ui/BackToTop';
---

<!doctype html>
<html lang={lang}>
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta
      content="AI engineering, LLM, RAG, software engineering"
      name="keywords"
    />
    <meta content={description} name="description" />
    <meta name="author" content="Julien Chapuy" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="fr"
      href={new URL(frPath === '/' ? '/' : `${frPath}/`, site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(enPath === '/en' ? '/en/' : `${enPath}/`, site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link href="/assets/img/icon.png" rel="icon" />
    <link href="/assets/img/icon.png" rel="apple-touch-icon" />

    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <link href="/lib/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="/lib/ionicons/css/ionicons.min.css" rel="stylesheet" />

    <link href="/assets/css/style.css" rel="stylesheet" />

    <style is:global>
      @import '../styles/global.scss';
    </style>
    <script is:inline>
      (function () {
        function applyTheme() {
          const savedTheme = localStorage.getItem('theme');
          const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
            .matches
            ? 'dark'
            : 'light';
          const theme = savedTheme || systemTheme;
          document.documentElement.setAttribute('data-theme', theme);
        }

        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body id="page-top">
    <Navbar lang={lang} />
    <slot />

    <BackToTop client:load />
  </body>
</html>
