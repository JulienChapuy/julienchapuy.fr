---
import Layout from '../../layouts/Layout.astro';

import BlogReact from '../../components/Blog/Blog';
import Footer from '../../components/Footer.astro';
import { siteData } from '../../data/copy';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'fr' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
  ];
}

const { lang } = Astro.props;
const data = siteData[lang as 'fr' | 'en'];
const content = data.insights;

const page = data.pages.blog;
---

<Layout
  title={page.title}
  description={page.description}
  lang={lang as 'fr' | 'en'}
>
  <div style="padding-top: 100px;">
    <BlogReact content={content} isDedicatedPage={true} />
    <Footer lang={lang as 'fr' | 'en'} />
  </div>
</Layout>
